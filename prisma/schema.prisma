// Prisma schema for DollarWatch

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Persists the generated daily brief across serverless invocations — a
// plain in-memory cache doesn't hold on Vercel, since each cold start
// gets its own process memory, which was silently burning through the
// Groq free-tier daily token quota by re-generating on every cold start
// instead of once per day.
model DailyBriefCache {
  dateKey     String   @id
  headline    String
  sections    Json
  generatedAt DateTime
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  phone                   String?
  createdAt               DateTime                 @default(now())
  emailVerified           DateTime?
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  subscription            Subscription?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorChallenges     TwoFactorChallenge[]
  watchlistItems          WatchlistItem[]
  priceAlerts             PriceAlert[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker    String
  createdAt DateTime @default(now())

  @@unique([userId, ticker])
  @@index([userId])
}

enum AlertDirection {
  above
  below
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker      String
  targetPrice Float
  direction   AlertDirection
  triggered   Boolean        @default(false)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([ticker])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Short-lived, single-use bridge between "password verified" and "TOTP
// verified" during a 2FA login — lets the second step re-authenticate via
// NextAuth's "two-factor" Credentials provider without ever re-transmitting
// or storing the plaintext password (see src/lib/auth.ts).
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SubscriptionStatus {
  none
  active
  past_due
  canceled
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(none)
  currentPeriodEnd     DateTime?
  updatedAt            DateTime           @updatedAt
}

enum InsiderDirection {
  buy
  sell
  other
}

// Real SEC Form 4 filings, backfilled from SEC's daily index (every filing
// for a given day, no cap) via scripts/scrape-insider-trades.mjs — unlike
// the live "current filings" feed (hard-capped at 100 entries regardless of
// requested count), this can hold a genuinely comprehensive day's worth.
model InsiderTrade {
  id                 String           @id @default(cuid())
  ticker             String
  issuerName         String
  ownerName          String
  relationship       String
  transactionDate    DateTime
  transactionCode    String
  direction          InsiderDirection
  shares             Float
  pricePerShare      Float?
  sharesOwnedAfter   Float?
  filedDate          DateTime
  filingUrl          String
  // Stable natural key: accession number + row index within that filing —
  // makes re-running the backfill idempotent instead of duplicating rows.
  externalId         String           @unique

  @@index([ticker])
  @@index([filedDate])
}
