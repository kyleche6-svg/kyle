// Prisma schema for DollarWatch

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  phone                   String?
  createdAt               DateTime                 @default(now())
  emailVerified           DateTime?
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  subscription            Subscription?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorChallenges     TwoFactorChallenge[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Short-lived, single-use bridge between "password verified" and "TOTP
// verified" during a 2FA login — lets the second step re-authenticate via
// NextAuth's "two-factor" Credentials provider without ever re-transmitting
// or storing the plaintext password (see src/lib/auth.ts).
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SubscriptionStatus {
  none
  active
  past_due
  canceled
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(none)
  currentPeriodEnd     DateTime?
  updatedAt            DateTime           @updatedAt
}

model TrackedFigure {
  id       String @id @default(cuid())
  name     String
  xHandle  String @unique
  category String
  posts    Post[]
}

model Post {
  id              String          @id @default(cuid())
  trackedFigureId String
  trackedFigure   TrackedFigure   @relation(fields: [trackedFigureId], references: [id], onDelete: Cascade)
  xPostId         String          @unique
  text            String
  postedAt        DateTime
  taggedTickers   String[]
  priceSnapshots  PriceSnapshot[]

  @@index([postedAt])
}

model PriceSnapshot {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  ticker      String
  windowLabel String // "-15m" | "+1h" | "eod"
  price       Float
  capturedAt  DateTime @default(now())

  @@index([postId])
}

enum TradeDirection {
  buy
  sell
}

model Trade {
  id              String         @id @default(cuid())
  politicianName  String
  ticker          String
  direction       TradeDirection
  amountRangeLow  Int
  amountRangeHigh Int
  filedDate       DateTime
  transactionDate DateTime
  // Stable natural key from the source filing (efdsearch.senate.gov PTR UUID
  // + row index) — makes re-running the scraper idempotent instead of
  // duplicating rows on every run.
  externalId      String?        @unique
  ptrLink         String?

  @@index([ticker])
  @@index([filedDate])
  @@index([politicianName])
}

enum EventImpact {
  high
  medium
  low
}

// Economic calendar (ForexFactory-style) — mock-seeded, no official free
// API exists (see plan notes on the politician-trades feature for the same
// situation). Real ingestion via a third-party economic-calendar API is a
// documented follow-up.
model EconomicEvent {
  id        String      @id @default(cuid())
  eventName String
  currency  String
  impact    EventImpact
  eventTime DateTime
  actual    String?
  forecast  String?
  previous  String?

  @@index([eventTime])
}
